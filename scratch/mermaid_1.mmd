    STRATEGIC_PLAN {
        string plan_id PK
        string plan_name
        int start_year
        int end_year
        string status
    }
    STRATEGIC_PRIORITY {
        string priority_id PK
        string strategic_plan_id FK
        string code
        string name
    }
    STRATEGIC_OBJECTIVE {
        string objective_id PK
        string strategic_priority_id FK
        string code "1.1, 1.2"
        string name
    }
    NATIONAL_ACTIVITY {
        string activity_id PK
        string activity_code "Unique (1.1.1)"
        string strategic_objective_id FK
        string department_id FK
        string name
        string uom FK
        string responsibility
        decimal ercs_target
        decimal ercs_budget
    }
    REGION_ACTIVITY_LINK {
        string link_id PK
        string national_activity_id FK
        string region_id FK
        string activity_name
        string activity_description
    }
    AOP_PLAN {
        string plan_id PK
        string plan_type "AOP-CORE | AOP-Donor"
        string fiscal_year
        string approval_status "Draft|In Review|Approved"
    }
    PROJECT {
        string project_id PK
        string name
        string lead_donor_id FK
        decimal total_budget
        string currency "ETB|EUR|USD"
        boolean is_contributing
    }
    PLAN_ENTRY {
        string plan_entry_id PK
        string plan_id FK
        string scope_type "Regional|Project|NonProgrammatic|HQ"
        string national_activity_id FK
        string zone_id FK
        string project_id FK
        string activity_description
        decimal annual_target
        decimal annual_budget
        string approval_status
    }
    QUARTERLY_PLAN {
        string quarterly_plan_id PK
        string plan_entry_id FK
        string quarter_id "Q1|Q2|Q3|Q4"
        decimal target
        decimal budget
        string approval_status
    }
    QUARTERLY_ACTUAL {
        string quarterly_actual_id PK
        string plan_entry_id FK
        string quarter_id "Q1|Q2|Q3|Q4"
        decimal actual
        decimal expenditure
        string variance_narrative
        string rejection_reason
        datetime submitted_at
        datetime reviewed_at
        string approval_status
    }
    MONITORING_REGISTER_RECORD {
        string record_id PK
        string plan_entry_id FK
        string quarter_id
        decimal verified_achieved
        string verification_result
        string quality_rating
    }
    FIELD_MONITORING_VISIT {
        string visit_id PK
        string plan_entry_id FK
        string region_id FK
        date visit_date
        string observations
        string recommendations
    }

    ELIGIBLE_ZONE_ITEM {
        string item_id PK
        string link_id FK
        string zone_id FK
    }
    OUTPUT {
        string output_id PK
        string activity_id FK
        string statement
    }
    OUTPUT_INDICATOR {
        string indicator_id PK
        string output_id FK
        string indicator_code
        decimal target
    }
    REGION {
        string region_id PK
        string code "REG-OR"
        string name "Oromia"
    }
    ZONE {
        string zone_id PK
        string region_id FK
        string code "ZN-BOR"
        string name "Borena"
