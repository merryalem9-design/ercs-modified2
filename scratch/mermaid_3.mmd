    DEPARTMENT {
        string department_id PK
        string department_name
        string code "Unique"
        boolean is_active
    }
    REGION {
        string region_id PK
        string code "REG-OR"
        string name "Oromia"
        string regional_branch_office
    }
    ZONE {
        string zone_id PK
        string region_id FK
        string code "ZN-BOR"
        string name "Borena"
    }
    PROJECT {
        string project_id PK
        string name
        string lead_donor_id FK
        decimal total_budget
        string currency "ETB|EUR|USD"
        decimal fx_rate_to_etb
        date start_date
        date end_date
        string location
        string community_type "Host|IDP|Refugee|Returnee"
        boolean is_contributing
    }
    DONOR {
        string donor_id PK
        string donor_name "IFRC|ICRC|USAID"
        string donor_type "PNS|Bilateral|Local"
    }
    PROJECT_DONOR_ALLOCATION {
        string allocation_id PK
        string project_id FK
        string donor_id FK
        decimal allocated_amount
        string funding_type "Grant|Local Match"
        string local_or_donor "Local|Donor"
    }
    REGION_ACTIVITY_LINK {
        string link_id PK
        string national_activity_id FK
        string region_id FK
        string activity_name
        string activity_description
    }
    ELIGIBLE_ZONE_ITEM {
        string item_id PK
        string link_id FK
        string zone_id FK
    }
    NON_PROGRAMMATIC_ACTIVITY {
        string npa_id PK
        string department_id FK
        string name
        string uom
        decimal annual_target "Optional (0)"
        decimal annual_budget "Mandatory"
        boolean is_admin_budget_line
    }
    PLAN_ENTRY {
        string plan_entry_id PK
        string plan_id FK
        string scope_type "Regional|Project|NonProgrammatic|HQ"
        string national_activity_id FK
        string non_programmatic_id FK
        string region_id FK
        string zone_id FK
        string project_id FK
        string region_activity_link_id FK
        string activity_description
        boolean is_contributing "Default 1"
        decimal annual_target "Locks budget if empty"
        decimal annual_budget "0 if target=0"
        decimal target_female
        decimal target_male
        decimal target_youth
        string community_type
        string approval_status
        boolean is_carried_forward
    }
    UOM_CONVERSION_FACTOR {
        string uom_id PK
        string uom_name "Household|Kit|Person"
        decimal beneficiary_multiplier "e.g. HH=5, 0=Admin"
    }

    AOP_PLAN {
        string plan_id PK
        string project_id FK
        string plan_type "AOP-CORE|AOP-Donor"
        string fiscal_year
        string calendar_type "Hamle-Sene|MOU"
        string scope_level "HQ|Branch|Project"
        string region_id FK
        string approval_status "Draft|Approved"
    }
    NATIONAL_ACTIVITY {
        string activity_id PK
        string activity_code "Unique 1.1.1"
        string strategic_objective_id FK
        string department_id FK
        string name
        string uom FK
    }
    QUARTERLY_PLAN {
        string quarterly_plan_id PK
        string plan_entry_id FK
        string quarter_id "Q1..Q4"
        decimal target
        decimal budget
        decimal fx_rate_to_etb
        string approval_status
    }
    WOREDA {
        string woreda_id PK
        string zone_id FK
        string name
    }
